{"n":"docker-volume-create","s":{"en":"Create a volume"},"syn":"docker volume create [OPTIONS] [VOLUME]","st":"gnu","o":[{"f":["--availability"],"en":"Cluster Volume availability (\"active\", \"pause\", \"drain\")"},{"f":["-d","--driver"],"en":"Specify volume driver name"},{"f":["--group"],"en":"Cluster Volume group (cluster volumes)"},{"f":["--label"],"en":"Set metadata for a volume"},{"f":["--limit-bytes"],"en":"Minimum size of the Cluster Volume in bytes","a":"0"},{"f":["-o","--opt"],"en":"Set driver specific options","a":"map"},{"f":["--required-bytes"],"en":"Maximum size of the Cluster Volume in bytes","a":"0"},{"f":["--scope"],"en":"Cluster Volume access scope (\"single\", \"multi\")"},{"f":["--secret"],"en":"Cluster Volume secrets","a":"map"},{"f":["--sharing"],"en":"Cluster Volume access sharing (\"none\", \"readonly\", \"onewriter\", \"all\")"},{"f":["--topology-preferred"],"en":"A topology that the Cluster Volume would be preferred in"},{"f":["--topology-required"],"en":"A topology that the Cluster Volume must be accessible from"},{"f":["--type"],"en":"Cluster Volume access type (\"mount\", \"block\")"}]}