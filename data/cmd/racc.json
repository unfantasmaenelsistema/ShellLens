{"n":"racc","s":{"en":"Ruby LALR parser generator"},"syn":"racc [options] file","st":"gnu","o":[{"f":["-g","--debug"],"en":"output parser for user level debugging."},{"f":["-o","--output-file"],"en":"file name of output. [<fname>.tab.rb]","a":"outfile"},{"f":["-e","--executable"],"en":"insert #! line in output. ('ruby' to default)","a":"rubypath"},{"f":["-E","--embedded"],"en":"output file which don't need runtime."},{"f":["-l","--no-line-convert"],"en":"never convert line numbers. (for ruby<=1.4.3)"},{"f":["-c","--line-convert-all"],"en":"convert line numbers also header and footer."},{"f":["-a","--no-omit-actions"],"en":"never omit actions."},{"f":["-v","--verbose"],"en":"create <filename>.output file."},{"f":["-O","--log-file"],"en":"file name of verbose output. [<fname>.output]","a":"fname"},{"f":["-C","--check-only"],"en":"syntax check only."},{"f":["-S","--output-status"],"en":"output status time to time."},{"f":["--no-extentions"],"en":"run without any ruby extentions."},{"f":["-h","--help"],"en":"print this message and quit."},{"f":["--version"],"en":"print version and quit."},{"f":["--runtime-version"],"en":"print runtime version and quit."},{"f":["--copyright"],"en":"print copyright and quit."}]}