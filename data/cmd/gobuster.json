{"n":"gobuster","s":{"en":"Directory/file, DNS and virtual host brute-forcing tool written in Go","es":"fuerza bruta de rutas web, subdominios, DNS y buckets"},"syn":"Modes: dir - Enumerate directories and files on web servers ⏎ dns - Discover subdomains through DNS resolution ⏎ s3 - Enumerate Amazon S3 buckets ⏎ gcs - Enumerate Google Cloud Storage buckets ⏎ vhost - Discover virtual hosts on web servers ⏎ fuzz - Custom fuzzing with the FUZZ keyword","st":"gnu","tg":["net"],"sd":{"dir":{"es":"Descubre directorios y archivos web.","en":"Discover web directories and files."},"dns":{"es":"Descubre subdominios por DNS.","en":"Discover subdomains via DNS."},"vhost":{"es":"Descubre hosts virtuales.","en":"Discover virtual hosts."},"fuzz":{"es":"Fuzzing con la palabra FUZZ.","en":"Fuzz using the FUZZ keyword."},"s3":{"es":"Descubre buckets de S3.","en":"Discover S3 buckets."}},"o":[{"f":["-u","--url"],"es":"URL objetivo.","en":"The target URL.","a":"URL"},{"f":["-w","--wordlist"],"es":"Diccionario de palabras.","en":"Path to the wordlist.","a":"ARCHIVO"},{"f":["-x","--extensions"],"es":"Extensiones a probar (php,txt,html).","en":"File extension(s) to search for.","a":"LISTA"},{"f":["-t","--threads"],"es":"Hilos.","en":"Number of concurrent threads.","a":"N"},{"f":["-o","--output"],"es":"Guarda el resultado.","en":"Output file to write results to.","a":"ARCHIVO"},{"f":["-s","--status-codes"],"es":"Códigos HTTP que se consideran válidos.","en":"Positive status codes.","a":"LISTA"},{"f":["-b","--status-codes-blacklist"],"es":"Códigos HTTP que se descartan.","en":"Negative status codes.","a":"LISTA"},{"f":["-k","--no-tls-validation"],"es":"No valida el certificado TLS.","en":"Skip TLS certificate verification."},{"f":["-q","--quiet"],"es":"No muestra la cabecera ni el progreso.","en":"Don't print the banner and other noise."},{"f":["-r","--follow-redirect"],"es":"Sigue redirecciones.","en":"Follow redirects."},{"f":["-d","--domain"],"es":"Con dns: dominio a probar.","en":"With dns: the target domain.","a":"DOMINIO"},{"f":["-e","--expanded"],"es":"Muestra la URL completa.","en":"Expanded mode, print full URLs."},{"f":["-a","--useragent"],"es":"User-Agent.","en":"Set the User-Agent string.","a":"TEXTO"},{"f":["-c","--cookies"],"es":"Cookies a enviar.","en":"Cookies to use for the requests.","a":"COOKIES"},{"f":["-H","--headers"],"es":"Cabecera a enviar.","en":"Specify HTTP headers.","a":"CABECERA"},{"f":["--delay"],"es":"Espera entre peticiones.","en":"Time each thread waits between requests.","a":"TIEMPO"},{"f":["--timeout"],"es":"Tiempo de espera HTTP.","en":"HTTP Timeout.","a":"TIEMPO"},{"f":["-p","--proxy","--pattern"],"es":"Proxy.","en":"Proxy to use.","a":"URL"},{"f":["--no-color"],"en":"Disable color output"},{"f":["--no-error"],"en":"Don't display errors"},{"f":["-z","--no-progress"],"en":"Don't display progress"},{"f":["-v","--verbose"],"en":"Verbose output (errors)"}]}