{"n":"uname","s":{"en":"print system information","es":"muestra información del sistema operativo y del núcleo"},"syn":"uname [OPTION]...","st":"gnu","tg":["read"],"o":[{"f":["-a","--all"],"es":"Toda la información.","en":"Print all information."},{"f":["-r","--kernel-release"],"es":"Versión del núcleo.","en":"Print the kernel release."},{"f":["-s","--kernel-name"],"es":"Nombre del núcleo.","en":"Print the kernel name."},{"f":["-m","--machine"],"es":"Arquitectura del hardware (x86_64, aarch64…).","en":"Print the machine hardware name."},{"f":["-n","--nodename"],"es":"Nombre del equipo.","en":"Print the network node hostname."},{"f":["-o","--operating-system"],"es":"Sistema operativo.","en":"Print the operating system."},{"f":["-v","--kernel-version"],"en":"print the kernel version"},{"f":["-p","--processor"],"en":"print the processor type (non-portable)"},{"f":["-i","--hardware-platform"],"en":"print the hardware platform (non-portable)"},{"f":["--help"],"en":"display this help and exit"},{"f":["--version"],"en":"output version information and exit"}]}