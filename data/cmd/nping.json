{"n":"nping","s":{"en":"Network packet generation tool / ping utility"},"syn":"nping [Options] {targets}","st":"gnu","o":[{"f":["--tcp-connect"],"en":": Unprivileged TCP connect probe mode."},{"f":["--tcp"],"en":": TCP probe mode."},{"f":["--udp"],"en":": UDP probe mode."},{"f":["--icmp"],"en":": ICMP probe mode."},{"f":["--arp"],"en":": ARP/RARP probe mode."},{"f":["--tr","--traceroute"],"en":": Traceroute mode (can only be used with TCP/UDP/ICMP modes)."},{"f":["-p","--dest-port"],"en":": Set destination port(s).","a":"port"},{"f":["-g","--source-port"],"en":": Try to use a custom source port.","a":"portnumber"},{"f":["--seq"],"en":": Set sequence number.","a":"seqnumber"},{"f":["--flags"],"en":": Set TCP flags (ACK,PSH,RST,SYN,FIN...)","a":"flag"},{"f":["--ack"],"en":": Set ACK number.","a":"acknumber"},{"f":["--win"],"en":": Set window size.","a":"size"},{"f":["--badsum"],"en":": Use a random invalid checksum."},{"f":["--icmp-type"],"en":": ICMP type.","a":"type"},{"f":["--icmp-code"],"en":": ICMP code.","a":"code"},{"f":["--icmp-id"],"en":": Set identifier.","a":"id"},{"f":["--icmp-seq"],"en":": Set sequence number.","a":"n"},{"f":["--icmp-redirect-addr"],"en":": Set redirect address.","a":"addr"},{"f":["--icmp-param-pointer"],"en":": Set parameter problem pointer.","a":"pnt"},{"f":["--icmp-advert-lifetime"],"en":": Set router advertisement lifetime.","a":"time"},{"f":["--icmp-advert-entry"],"en":": Add router advertisement entry.","a":"IP,pref"},{"f":["--icmp-orig-time"],"en":"<timestamp> : Set originate timestamp."},{"f":["--icmp-recv-time"],"en":"<timestamp> : Set receive timestamp."},{"f":["--icmp-trans-time"],"en":": Set transmit timestamp.","a":"timestamp"},{"f":["--arp-type"],"en":": Type: ARP, ARP-reply, RARP, RARP-reply.","a":"type"},{"f":["--arp-sender-mac"],"en":": Set sender MAC address.","a":"mac"},{"f":["--arp-sender-ip"],"en":"<addr> : Set sender IP address."},{"f":["--arp-target-mac"],"en":": Set target MAC address.","a":"mac"},{"f":["--arp-target-ip"],"en":"<addr> : Set target IP address."},{"f":["-S","--source-ip"],"en":": Set source IP address."},{"f":["--dest-ip"],"en":": Set destination IP address (used as an alternative to {target specification} ).","a":"addr"},{"f":["--tos"],"en":": Set type of service field (8bits).","a":"tos"},{"f":["--id"],"en":"<id> : Set identification field (16 bits)."},{"f":["--df"],"en":": Set Don't Fragment flag."},{"f":["--mf"],"en":": Set More Fragments flag."},{"f":["--evil"],"en":": Set Reserved / Evil flag."},{"f":["--ttl"],"en":": Set time to live [0-255].","a":"hops"},{"f":["--badsum-ip"],"en":": Use a random invalid checksum."},{"f":["--ip-options"],"en":"","a":"S|R"},{"f":["--mtu"],"en":": Set MTU. Packets get fragmented if MTU is small enough.","a":"size"},{"f":["-6","--IPv6"],"en":": Use IP version 6."},{"f":["--hop-limit"],"en":": Set hop limit (same as IPv4 TTL)."},{"f":["--traffic-class"],"en":": Set traffic class.","a":"class"},{"f":["--flow"],"en":": Set flow label.","a":"label"},{"f":["--dest-mac"],"en":": Set destination mac address. (Disables ARP resolution)","a":"mac"},{"f":["--source-mac"],"en":": Set source MAC address.","a":"mac"},{"f":["--ether-type"],"en":": Set EtherType value.","a":"type"},{"f":["--data"],"en":": Include a custom payload.","a":"hex"},{"f":["--data-string"],"en":": Include a custom ASCII text.","a":"text"},{"f":["--data-length"],"en":": Include len random bytes as payload.","a":"len"},{"f":["--echo-client"],"en":": Run Nping in client mode.","a":"passphrase"},{"f":["--echo-server"],"en":": Run Nping in server mode.","a":"passphrase"},{"f":["--echo-port"],"en":": Use custom <port> to listen or connect.","a":"port"},{"f":["--no-crypto"],"en":": Disable encryption and authentication."},{"f":["--once"],"en":": Stop the server after one connection."},{"f":["--safe-payloads"],"en":": Erase application data in echoed packets."},{"f":["--delay"],"en":": Adjust delay between probes.","a":"time"},{"f":["--rate"],"en":"<rate> : Send num packets per second."},{"f":["-h","--help"],"en":": Display help information."},{"f":["-V","--version"],"en":": Display current version number."},{"f":["-c","--count"],"en":": Stop after <n> rounds.","a":"n"},{"f":["-e","--interface"],"en":": Use supplied network interface.","a":"name"},{"f":["-H","--hide-sent"],"en":": Do not display sent packets."},{"f":["-N","--no-capture"],"en":": Do not try to capture replies."},{"f":["--privileged"],"en":": Assume user is fully privileged."},{"f":["--unprivileged"],"en":": Assume user lacks raw socket privileges."},{"f":["--send-eth"],"en":": Send packets at the raw Ethernet layer."},{"f":["--send-ip"],"en":": Send packets using raw IP sockets."},{"f":["--bpf-filter"],"en":": Specify custom BPF filter.","a":"filter"},{"f":["-v"],"en":": Increment verbosity level by one."},{"f":["-d"],"en":": Increment debugging level by one."},{"f":["-q"],"en":": Decrease verbosity level by one."},{"f":["--quiet"],"en":": Set verbosity and debug level to minimum."},{"f":["--debug"],"en":": Set verbosity and debug to the max level."}]}