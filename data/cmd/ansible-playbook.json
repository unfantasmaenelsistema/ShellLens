{"n":"ansible-playbook","s":{"en":"run an Ansible playbook: automate configuration of many hosts","es":"ejecuta un playbook de Ansible: automatiza la configuración de muchos equipos"},"st":"gnu","tg":["net","exec"],"o":[{"f":["-i","--inventory"],"es":"Inventario de equipos.","en":"Inventory of hosts.","a":"ARCHIVO"},{"f":["-b","--become"],"es":"Escala privilegios (como sudo).","en":"Escalate privileges (like sudo)."},{"f":["-K","--ask-become-pass"],"es":"Pide la contraseña de sudo.","en":"Ask for the sudo password."},{"f":["-k","--ask-pass"],"es":"Pide la contraseña SSH.","en":"Ask for the SSH password."},{"f":["-u","--user"],"es":"Usuario remoto.","en":"Remote user.","a":"USUARIO"},{"f":["-l","--limit"],"es":"Limita a ciertos equipos.","en":"Limit to certain hosts.","a":"PATRÓN"},{"f":["-C","--check"],"es":"Modo simulación: no cambia nada.","en":"Dry-run mode: changes nothing."},{"f":["-D","--diff"],"es":"Muestra las diferencias que aplicaría.","en":"Show the differences it would apply."},{"f":["-e","--extra-vars"],"es":"Variables extra (clave=valor o @archivo).","en":"Extra variables (key=value or @file).","a":"VARS"},{"f":["-t","--tags"],"es":"Ejecuta solo tareas con esas etiquetas.","en":"Only run tasks with these tags.","a":"ETIQUETAS"},{"f":["--syntax-check"],"es":"Solo comprueba la sintaxis.","en":"Only check the syntax."},{"f":["-v"],"es":"Detallado (-vvv más).","en":"Verbose (-vvv for more)."},{"f":["--vault-password-file"],"es":"Archivo con la contraseña de Ansible Vault.","en":"File with the Ansible Vault password.","a":"ARCHIVO"}]}