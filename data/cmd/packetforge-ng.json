{"n":"packetforge-ng","s":{"en":"forge packets: ARP, UDP, ICMP or custom packets."},"syn":"packetforge-ng <mode> <options>","st":"gnu","o":[{"f":["-H","--help"],"en":"Shows the help screen."},{"f":["-p"],"en":"Set frame control word (hex)","a":"fctrl"},{"f":["-a"],"en":"Set Access Point MAC address","a":"bssid"},{"f":["-c"],"en":"Set Destination MAC address","a":"dmac"},{"f":["-h"],"en":"Set Source MAC address","a":"smac"},{"f":["-j"],"en":"set FromDS bit"},{"f":["-o"],"en":"clear ToDS bit"},{"f":["-e"],"en":"disable WEP encryption"},{"f":["-k"],"en":"Set destination IP (and port)","a":"ip:[port"},{"f":["-l"],"en":"Set source IP (and port)","a":"ip:[port"},{"f":["-w"],"en":"Write packet to this pcap file","a":"file"},{"f":["-r"],"en":"Read packet from this pcap file","a":"file"},{"f":["-y"],"en":"Read PRGA from this file","a":"file"},{"f":["-t"],"en":"Set Time To Live in IP-Header","a":"ttl"},{"f":["-s"],"en":"Set size of the generated null packet.","a":"size"},{"f":["-0","--arp"],"en":"Forge an ARP packet"},{"f":["-1","--udp"],"en":"Forge an UDP packet"},{"f":["-2","--icmp"],"en":"Forge an ICMP packet"},{"f":["-3","--null"],"en":"Forge a llc null packet"},{"f":["-9","--custom"],"en":"Build a custom packet, requires -r to read an unencrypted frame out of a pcap file."}]}