{"n":"csplit","s":{"en":"split a file into sections determined by context lines"},"syn":"csplit [OPTION]... FILE PATTERN...","st":"gnu","o":[{"f":["-b","--suffix-format"],"en":"use sprintf FORMAT instead of %02d","a":"FORMAT"},{"f":["-f","--prefix"],"en":"use PREFIX instead of 'xx'","a":"PREFIX"},{"f":["-k","--keep-files"],"en":"do not remove output files on errors"},{"f":["--suppress-matched"],"en":"suppress the lines matching PATTERN"},{"f":["-n","--digits"],"en":"use specified number of digits instead of 2","a":"DIGITS"},{"f":["-s","--quiet","--silent"],"en":"do not print counts of output file sizes"},{"f":["-z","--elide-empty-files"],"en":"suppress empty output files"},{"f":["--help"],"en":"display this help and exit"},{"f":["--version"],"en":"output version information and exit"}]}