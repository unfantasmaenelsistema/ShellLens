{"n":"mvxattr","s":{"en":"Recursively rename extended attributes"},"syn":"mvxattr {-s STRING, --from=STRING} {-d STRING, --to=STRING} [-l, --follow-symlinks] [-p, --print] [-v, --verbose] [-f, --force] {PATH [PATH ...]}","st":"gnu","o":[{"f":["-s","--from"],"en":"Source xattr name","a":"STRING"},{"f":["-d","--to"],"en":"Destination xattr name","a":"STRING"},{"f":["-l","--follow-symlinks"],"en":"Follow symlinks, the default is to ignore them."},{"f":["-p","--print"],"en":"Print files where the xattr got renamed."},{"f":["-v","--verbose"],"en":"Print files as they are checked."},{"f":["-f","--force"],"en":"Force overwriting of destination xattr."}]}