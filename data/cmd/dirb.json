{"n":"dirb","s":{"en":"Web Content Scanner","es":"fuerza bruta de directorios y archivos web con diccionario"},"al":["dirbuster"],"syn":"dirb <url_base> <url_base> [<wordlist_file(s)>] [options]","st":"gnu","tg":["net"],"o":[{"f":["-a"],"es":"User-Agent.","en":"Specify your custom USER_AGENT.","a":"TEXTO"},{"f":["-o"],"es":"Guarda la salida.","en":"Save output to disk.","a":"ARCHIVO"},{"f":["-X"],"es":"Extensiones a probar.","en":"Append each word with this extensions.","a":"EXTENSIONES"},{"f":["-r"],"es":"No busca recursivamente.","en":"Don't search recursively."},{"f":["-S"],"es":"Modo silencioso.","en":"Silent Mode."},{"f":["-b"],"en":"Don't squash or merge sequences of /../ or /./ in the given URL."},{"f":["-c"],"en":"Set a cookie for the HTTP request.","a":"cookie_string"},{"f":["-E"],"en":"Use the specified client certificate file.","a":"certificate"},{"f":["-f"],"en":"Fine tunning of NOT_FOUND (404) detection."},{"f":["-H"],"en":"Add a custom header to the HTTP request.","a":"header_string"},{"f":["-i"],"en":"Use case-insensitive Search."},{"f":["-l"],"en":"Print \"Location\" header when found."},{"f":["-N"],"en":"Ignore responses with this HTTP code.","a":"nf_code"},{"f":["-p"],"en":"Use this proxy. (Default port is 1080)","a":"proxy[:port"},{"f":["-P"],"en":"Proxy Authentication.","a":"proxy_username:proxy_password"},{"f":["-R"],"en":"Interactive Recursion. (Ask in which directories you want to scan)"},{"f":["-t"],"en":"Don't force an ending '/' on URLs."},{"f":["-u"],"en":"Username and password to use.","a":"username:password"},{"f":["-v"],"en":"Show Also Not Existent Pages."},{"f":["-w"],"en":"Don't Stop on WARNING messages."},{"f":["-x"],"en":"Amplify search with the extensions on this file.","a":"extensions_file"},{"f":["-z"],"en":"Amplify search with this extensions.","a":"milisecs"}]}