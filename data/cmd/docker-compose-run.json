{"n":"docker-compose-run","s":{"en":"Run a one-off command on a service"},"syn":"docker compose run [OPTIONS] SERVICE [COMMAND] [ARGS...]","st":"gnu","o":[{"f":["--build"],"en":"Build image before starting container","a":"false","ao":1},{"f":["--cap-add"],"en":"Add Linux capabilities"},{"f":["--cap-drop"],"en":"Drop Linux capabilities"},{"f":["-d","--detach"],"en":"Run container in background and print container ID","a":"false","ao":1},{"f":["--entrypoint"],"en":"Override the entrypoint of the image"},{"f":["-e","--env"],"en":"Set environment variables"},{"f":["--env-from-file"],"en":"Set environment variables from file"},{"f":["-h","--help"],"en":"help for run","a":"false","ao":1},{"f":["-i","--interactive"],"en":"Keep STDIN open even if not attached","a":"true","ao":1},{"f":["-l","--label"],"en":"Add or override a label"},{"f":["--name"],"en":"Assign a name to the container"},{"f":["-T","--no-TTY"],"en":"Disable pseudo-TTY allocation (default: auto-detected)","a":"true","ao":1},{"f":["--no-deps"],"en":"Don't start linked services","a":"false","ao":1},{"f":["-p","--publish"],"en":"Publish a container's port(s) to the host"},{"f":["--pull"],"en":"Pull image before running (\"always\"|\"missing\"|\"never\")"},{"f":["-q","--quiet"],"en":"Don't print anything to STDOUT","a":"false","ao":1},{"f":["--quiet-build"],"en":"Suppress progress output from the build process","a":"false","ao":1},{"f":["--quiet-pull"],"en":"Pull without printing progress information","a":"false","ao":1},{"f":["--remove-orphans"],"en":"Remove containers for services not defined in the Compose file","a":"false","ao":1},{"f":["--rm"],"en":"Automatically remove the container when it exits","a":"false","ao":1},{"f":["-P","--service-ports"],"en":"Run command with all service's ports enabled and mapped to the host","a":"false","ao":1},{"f":["--use-aliases"],"en":"Use the service's network useAliases in the network(s) the container connects to","a":"false","ao":1},{"f":["-u","--user"],"en":"Run as specified username or uid"},{"f":["-v","--volume"],"en":"Bind mount a volume"},{"f":["-w","--workdir"],"en":"Working directory inside the container"},{"f":["--dry-run"],"en":"Execute command in dry run mode","a":"false","ao":1}]}