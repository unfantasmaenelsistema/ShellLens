{"n":"redis-benchmark","s":{"en":"Benechmark a Redis instance"},"syn":"redis-benchmark [-h <host>] [-p <port>] [-c <clients>] [-n <requests]> [-k <boolean>]","st":"gnu","o":[{"f":["-h"],"en":"Server hostname (default 127.0.0.1)","a":"hostname"},{"f":["-p"],"en":"Server port (default 6379)","a":"port"},{"f":["-s"],"en":"Server socket (overrides host and port)","a":"socket"},{"f":["-a"],"en":"Password for Redis Auth","a":"password"},{"f":["-c"],"en":"Number of parallel connections (default 50)","a":"clients"},{"f":["-n"],"en":"Total number of requests (default 100000)","a":"requests"},{"f":["-d"],"en":"Data size of SET/GET value in bytes (default 2)","a":"size"},{"f":["-dbnum"],"en":"SELECT the specified db number (default 0)","a":"db"},{"f":["-k"],"en":"1=keep alive 0=reconnect (default 1)","a":"boolean"},{"f":["-r"],"en":"Use random keys for SET/GET/INCR, random values for SADD Using this option the benchmark will get/set keys in the form mykey_rand000000012456 instead of constant keys, the <keyspacelen> argument determines the max number of values for the random number.","a":"keyspacelen"},{"f":["-P"],"en":"Pipeline <numreq> requests. Default 1 (no pipeline).","a":"numreq"},{"f":["-q"],"en":"Quiet. Just show query/sec values"},{"f":["--csv"],"en":"Ourput in CSV format"},{"f":["-l"],"en":"Loop. Run the tests forever"},{"f":["-I"],"en":"Idle mode. Just open N idle connections and wait."},{"f":["-D"],"en":"Debug mode. more verbose."}]}