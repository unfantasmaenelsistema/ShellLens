{"n":"who","s":{"en":"show who is logged on","es":"muestra quién tiene sesión abierta en el sistema"},"syn":"who [OPTION]... [ FILE | ARG1 ARG2 ]","st":"gnu","tg":["read"],"o":[{"f":["-a","--all"],"es":"Toda la información disponible.","en":"Same as -b -d --login -p -r -t -T -u."},{"f":["-b","--boot"],"es":"Hora del último arranque.","en":"Time of last system boot."},{"f":["-H","--heading"],"es":"Muestra una fila de cabecera.","en":"Print line of column headings."},{"f":["-d","--dead"],"en":"print dead processes"},{"f":["-l","--login"],"en":"print system login processes"},{"f":["--lookup"],"en":"attempt to canonicalize hostnames via DNS"},{"f":["-m"],"en":"only hostname and user associated with standard input"},{"f":["-p","--process"],"en":"print active processes spawned by init"},{"f":["-q","--count"],"en":"all login names and number of users logged on"},{"f":["-r","--runlevel"],"en":"print current runlevel"},{"f":["-s","--short"],"en":"print only name, line, and time (default)"},{"f":["-t","--time"],"en":"print last system clock change"},{"f":["-T","-w","--mesg"],"en":"add user's message status as +, - or ?"},{"f":["-u","--users"],"en":"list users logged in, including idle time"},{"f":["--message"],"en":"same as -T"},{"f":["--writable"],"en":"same as -T"},{"f":["--help"],"en":"display this help and exit"},{"f":["--version"],"en":"output version information and exit"}]}